import numpy as np
import pandas as pd
from tqdm.auto import tqdm

TOP_DOCS = 20
TOP_CONTEXT_CHUNKS = 5
CHUNK_BATCH_SIZE = 64

dev_hybrid_chunks = []

# Reuse the document cache created earlier
for i, question in enumerate(tqdm(dev_questions, desc="Hybrid context selection")):
    ranked_docs = [
        str(doc_id) for doc_id in dev_fused_rankings[i][:TOP_DOCS]
    ]

    candidates = []

    for doc_rank, doc_id in enumerate(ranked_docs, start=1):
        doc_chunks = document_chunk_cache.get(doc_id)
        if doc_chunks is None:
            continue

        for _, chunk in doc_chunks.iterrows():
            candidates.append({
                "document_id": doc_id,
                "title": chunk["title"],
                "section": chunk["section"],
                "chunk_index": int(chunk["chunk_index"]),
                "text": str(chunk["text"]),
                "document_rank": doc_rank
            })

    candidate_df = pd.DataFrame(candidates)

    if candidate_df.empty:
        dev_hybrid_chunks.append(candidate_df)
        continue

    texts = candidate_df["text"].tolist()

    chunk_embeddings = embed_model.encode(
        texts,
        batch_size=CHUNK_BATCH_SIZE,
        show_progress_bar=False,
        convert_to_numpy=True,
        normalize_embeddings=True
    )

    similarities = (
        np.asarray(chunk_embeddings) @ dev_query_embeddings[i]
    )

    candidate_df["similarity"] = similarities

    # Convert document rank into a normalized score
    candidate_df["document_score"] = (
        1.0 / candidate_df["document_rank"]
    )

    # Combine semantic similarity with document rank
    candidate_df["hybrid_score"] = (
        0.8 * candidate_df["similarity"]
        + 0.2 * candidate_df["document_score"]
    )

    candidate_df = candidate_df.sort_values(
        "hybrid_score", ascending=False
    ).reset_index(drop=True)

    # Avoid filling all slots with chunks from one document
    selected_rows = []
    document_counts = {}

    for _, row in candidate_df.iterrows():
        doc_id = row["document_id"]

        if document_counts.get(doc_id, 0) >= 2:
            continue

        selected_rows.append(row)
        document_counts[doc_id] = document_counts.get(doc_id, 0) + 1

        if len(selected_rows) == TOP_CONTEXT_CHUNKS:
            break

    dev_hybrid_chunks.append(pd.DataFrame(selected_rows))

