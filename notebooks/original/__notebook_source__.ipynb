import numpy as np
import pandas as pd
from tqdm.auto import tqdm

TOP_DOCS = 20
TOP_CONTEXT_CHUNKS = 5

dev_document_aware_chunks = []

# Cache each document's chunks to avoid repeatedly filtering all 151k rows
document_chunk_cache = {
    str(doc_id): group.sort_values("chunk_index").copy()
    for doc_id, group in chunks_df.groupby("document_id", sort=False)
}

for i, question in enumerate(tqdm(dev_questions, desc="Document-aware selection")):
    ranked_docs = [
        str(doc_id) for doc_id in dev_fused_rankings[i][:TOP_DOCS]
    ]

    candidates = []

    for doc_rank, doc_id in enumerate(ranked_docs, start=1):
        doc_chunks = document_chunk_cache.get(doc_id)

        if doc_chunks is None or doc_chunks.empty:
            continue

        # Prefer early chunks, but use semantic similarity as well
        for _, chunk in doc_chunks.iterrows():
            text = str(chunk["text"])
            chunk_index = int(chunk["chunk_index"])

            candidates.append({
                "document_id": doc_id,
                "title": chunk["title"],
                "section": chunk["section"],
                "chunk_index": chunk_index,
                "text": text,
                "document_rank": doc_rank,
                "similarity": np.nan
            })

    candidate_df = pd.DataFrame(candidates)

    if candidate_df.empty:
        dev_document_aware_chunks.append(candidate_df)
        continue

    # Rank by document-level RRF order first, then by chunk position
    # This intentionally tests a simple rank/position baseline.
    candidate_df = candidate_df.sort_values(
        ["document_rank", "chunk_index"],
        ascending=[True, True],
        kind="stable"
    )

    selected = candidate_df.head(TOP_CONTEXT_CHUNKS).copy()
    dev_document_aware_chunks.append(selected)

