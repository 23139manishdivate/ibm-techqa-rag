import re
from rank_bm25 import BM25Okapi

# Preserve technical identifiers; clean only trailing punctuation.
base_pattern = re.compile(r"[a-zA-Z0-9][a-zA-Z0-9._/-]*")
split_pattern = re.compile(r"[-_/]+")

def tokenize_fixed(text):
    raw_tokens = base_pattern.findall(str(text).lower())
    tokens = []

    for raw in raw_tokens:
        token = raw.rstrip(".,;:!?")
        if not token:
            continue

        # Keep the complete token.
        tokens.append(token)

        # Add identifier components as extra searchable terms.
        # Example: ora-12514 -> ora-12514, ora, 12514
        if any(sep in token for sep in "-_/"):
            tokens.extend(part for part in split_pattern.split(token) if part)

    return tokens

# Validate the fix before expensive work.
for sample in [
    "failed.",
    "ORA-12514",
    "CVE-2017-3156",
    "WebSphere 9.0.5",
    "IBM technote swg21996508.",
]:
    print(repr(sample), "->", tokenize_fixed(sample))

# Rebuild lexical token lists and BM25 only.
# Existing BGE-M3 embeddings and FAISS index remain untouched.
tokenized_chunks_fixed = [
    tokenize_fixed(text)
    for text in chunks_df["text"].fillna("").astype(str)
]

assert len(tokenized_chunks_fixed) == len(chunks_df)

bm25_index_fixed = BM25Okapi(tokenized_chunks_fixed)

print("\nBM25 rebuild complete.")
print("Tokenized documents:", len(tokenized_chunks_fixed))
print("BM25 corpus size:", bm25_index_fixed.corpus_size)




