for i, question in enumerate(questions):
    q_tokens = (
        set(re.findall(
            r"[a-zA-Z0-9][a-zA-Z0-9._/-]*",
            str(question).lower()
        )) - STOPWORDS
    )

    doc_scores = defaultdict(lambda: float("-inf"))

    for rank, idx in enumerate(hybrid_rankings[i], start=1):
        row = chunks_df.iloc[idx]
        doc_id = str(row["document_id"])
        title = row["title"] if "title" in chunks_df.columns else ""

        t_tokens = (
            set(re.findall(
                r"[a-zA-Z0-9][a-zA-Z0-9._/-]*",
                str(title).lower()
            )) - STOPWORDS
        )

        overlap = len(q_tokens & t_tokens) / max(len(q_tokens), 1)
        score = 1.0 / (RRF_K + rank) + WEIGHT * overlap

        doc_scores[doc_id] = max(doc_scores[doc_id], score)

    ranked_docs = sorted(
        doc_scores.items(),
        key=lambda item: item[1],
        reverse=True
    )
    max_doc_rankings.append([doc_id for doc_id, _ in ranked_docs])

