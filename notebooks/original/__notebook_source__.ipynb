def evaluate_doc_recall(rankings, ground_truth, ks=(5, 10, 20, 50, 100)):
    results = {}

    for k in ks:
        hits = 0

        for ranked, gold in zip(rankings, ground_truth):
            # Treat a string as one complete document ID
            if isinstance(gold, str):
                gold_ids = {gold.strip()}
            else:
                gold_ids = {str(x).strip() for x in gold}

            ranked_ids = {str(x).strip() for x in ranked[:k]}

            if gold_ids & ranked_ids:
                hits += 1

        results[f"Recall@{k}"] = round(100 * hits / len(ground_truth), 2)

    return results


results = evaluate_doc_recall(
    semantic_bm25_title_rankings,
    ground_truth
)

