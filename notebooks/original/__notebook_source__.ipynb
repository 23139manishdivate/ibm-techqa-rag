import re
import numpy as np

STOPWORDS = {
    "the", "is", "are", "was", "were", "a", "an", "and", "or",
    "to", "of", "in", "on", "for", "with", "what", "when",
    "where", "how", "does", "do", "can", "could", "would",
    "should", "it", "this", "that", "by", "from", "be", "my"
}

def title_tokens(text):
    return set(
        re.findall(r"[a-zA-Z0-9][a-zA-Z0-9._/-]*", str(text).lower())
    )

# Cache title overlap scores so we don't recompute them for each weight
title_overlap_cache = []

for i, question in enumerate(questions):
    q_tokens = title_tokens(question) - STOPWORDS
    candidate_ids = hybrid_rankings[i][:200]

    overlaps = []
    for idx in candidate_ids:
        title = str(chunks_df.iloc[idx]["title"])
        t_tokens = title_tokens(title) - STOPWORDS
        overlap = len(q_tokens & t_tokens) / max(len(q_tokens), 1)
        overlaps.append(overlap)

    title_overlap_cache.append(np.array(overlaps))

weights = [0.01, 0.02, 0.05]
weight_rankings = {}

for weight in weights:
    rankings = []

    for i, question in enumerate(questions):
        candidate_ids = hybrid_rankings[i][:200]
        overlaps = title_overlap_cache[i]

        # Preserve RRF score and add title overlap boost
        scores = np.array([
            1.0 / (60 + rank)
            for rank in range(1, len(candidate_ids) + 1)
        ]) + weight * overlaps

        order = np.argsort(scores)[::-1]
        rankings.append([candidate_ids[j] for j in order])

    weight_rankings[weight] = rankings

# Evaluate each weight
for weight, rankings in weight_rankings.items():
    print(f"\nTitle boost weight: {weight}")

    for k in [5, 10, 20, 50, 100]:
        hits = 0

        for i, correct_doc in enumerate(ground_truth):
            retrieved_docs = {
                chunks_df.iloc[idx]["document_id"]
                for idx in rankings[i][:k]
            }
            hits += int(correct_doc in retrieved_docs)

        print(f"Recall@{k}: {hits / len(ground_truth):.4f}")



