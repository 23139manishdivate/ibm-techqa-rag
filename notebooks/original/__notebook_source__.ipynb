def generate_rag_answer(question, chunks, max_new_tokens=180):
    context = build_context(chunks)

    messages = [
        {
            "role": "system",
            "content": (
                "You are a precise technical support assistant. "
                "Read both the question and the retrieved context carefully. "
                "The question may itself contain important facts, error "
                "messages, version numbers, and requirements. Use those facts "
                "as evidence, along with the context. "
                "Answer the exact question directly. Compare stated version "
                "numbers when relevant. Do not say information is missing "
                "if it is explicitly provided in the question or context. "
                "Do not invent facts unsupported by either source. "
                "If the evidence is genuinely insufficient, say so briefly."
            )
        },
        {
            "role": "user",
            "content": (
                f"Question:\n{question}\n\n"
                f"Retrieved context:\n{context}\n\n"
                "Give the direct answer and briefly explain the evidence."
            )
        }
    ]

    prompt = tokenizer.apply_chat_template(
        messages,
        tokenize=False,
        add_generation_prompt=True
    )

    inputs = tokenizer(
        prompt,
        return_tensors="pt",
        truncation=True,
        max_length=4096
    ).to(DEVICE)

    with torch.inference_mode():
        output = llm.generate(
            **inputs,
            max_new_tokens=max_new_tokens,
            do_sample=False,
            pad_token_id=tokenizer.eos_token_id
        )

    generated_tokens = output[0][inputs["input_ids"].shape[1]:]
    return tokenizer.decode(
        generated_tokens,
        skip_special_tokens=True
    ).strip()


