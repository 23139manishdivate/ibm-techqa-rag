import time
import numpy as np
import torch
from transformers import AutoTokenizer, AutoModelForSequenceClassification

RERANKER_NAME = "BAAI/bge-reranker-v2-m3"

device = "cuda" if torch.cuda.is_available() else "cpu"

tokenizer = AutoTokenizer.from_pretrained(RERANKER_NAME)
reranker = AutoModelForSequenceClassification.from_pretrained(
    RERANKER_NAME
).to(device)
reranker.eval()

print("Reranker loaded:", RERANKER_NAME)
print("Device:", device)




import time

PILOT_QUESTIONS = min(10, len(questions))
BATCH_SIZE = 16
MAX_LENGTH = 512

pilot_rankings = []
start_time = time.time()

for i in range(PILOT_QUESTIONS):
    candidate_ids = hybrid_rankings[i][:200]
    pairs = [
        (questions[i], str(chunks_df.iloc[idx]["text"]))
        for idx in candidate_ids
    ]

    candidate_scores = []

    for start in range(0, len(pairs), BATCH_SIZE):
        batch_pairs = pairs[start:start + BATCH_SIZE]

        encoded = tokenizer(
            [p[0] for p in batch_pairs],
            [p[1] for p in batch_pairs],
            padding=True,
            truncation=True,
            max_length=MAX_LENGTH,
            return_tensors="pt"
        ).to(device)

        with torch.inference_mode():
            logits = reranker(**encoded).logits.squeeze(-1)

        candidate_scores.extend(logits.float().cpu().tolist())

    ranked_ids = [
        candidate_ids[j]
        for j in np.argsort(candidate_scores)[::-1]
    ]
    pilot_rankings.append(ranked_ids)

    print(f"Pilot question {i + 1}/{PILOT_QUESTIONS} completed")

elapsed = time.time() - start_time
print(f"\nPilot time: {elapsed:.1f} seconds")
print(f"Estimated full run: {elapsed * len(questions) / PILOT_QUESTIONS / 60:.1f} minutes")



for k in [5, 10, 20]:
    hybrid_hits = 0
    reranked_hits = 0

    for i in range(PILOT_QUESTIONS):
        correct_doc = ground_truth[i]

        hybrid_docs = {
            chunks_df.iloc[idx]["document_id"]
            for idx in hybrid_rankings[i][:k]
        }
        reranked_docs = {
            chunks_df.iloc[idx]["document_id"]
            for idx in pilot_rankings[i][:k]
        }

        hybrid_hits += int(correct_doc in hybrid_docs)
        reranked_hits += int(correct_doc in reranked_docs)

    print(
        f"Recall@{k} | "
        f"Hybrid: {hybrid_hits}/{PILOT_QUESTIONS} | "
        f"Reranked: {reranked_hits}/{PILOT_QUESTIONS}"
    )



# Compare hybrid vs reranked results for the 10 pilot questions

for i in range(PILOT_QUESTIONS):
    correct_doc = ground_truth[i]

    hybrid_top5 = [
        chunks_df.iloc[idx]["document_id"]
        for idx in hybrid_rankings[i][:5]
    ]
    reranked_top5 = [
        chunks_df.iloc[idx]["document_id"]
        for idx in pilot_rankings[i][:5]
    ]

    hybrid_hit = correct_doc in hybrid_top5
    reranked_hit = correct_doc in reranked_top5

    if hybrid_hit and not reranked_hit:
        print(f"\nQuestion {i + 1}")
        print("Question:", questions[i])
        print("Correct document:", correct_doc)
        print("Hybrid rank:", hybrid_top5.index(correct_doc) + 1)
        print("Reranked top 5:")
        for rank, idx in enumerate(pilot_rankings[i][:5], 1):
            chunk = chunks_df.iloc[idx]
            print(f"  {rank}. {chunk['document_id']} — {chunk['title']}")




