import os
import pandas as pd
import torch
from tqdm.auto import tqdm

MAX_INPUT_TOKENS = 4096
MAX_NEW_TOKENS = 180
OUTPUT_PATH = "/kaggle/working/oracle_context_results.csv"

context_columns = {
    "full_document": "context_A_full_document",
    "answer_passage": "context_B_answer_passage",
    "hybrid": "context_C_hybrid",
}

system_prompt = (
    "Answer the question using only the supplied IBM technical documentation. "
    "Be concise and preserve exact technical identifiers. "
    "Do not invent fixes, APAR numbers, or commands. "
    "If the evidence does not support an answer, say so."
)

# Resume from a previous run if the progress file exists.
if os.path.exists(OUTPUT_PATH):
    oracle_results = pd.read_csv(OUTPUT_PATH).to_dict("records")
    completed = {
        (r["question_id"], r["context_type"])
        for r in oracle_results
    }
    print("Resuming existing results:", len(completed))
else:
    oracle_results = []
    completed = set()

model.eval()

for _, row in tqdm(oracle_df.iterrows(), total=len(oracle_df)):
    qid = str(row["question_id"])

    for context_type, context_col in context_columns.items():
        if (qid, context_type) in completed:
            continue

        context = str(row[context_col])
        messages = [
            {"role": "system", "content": system_prompt},
            {
                "role": "user",
                "content": (
                    f"Question:\n{row['question']}\n\n"
                    f"Documentation context:\n{context}\n\n"
                    "Give a direct answer supported by the context."
                ),
            },
        ]

        prompt = tokenizer.apply_chat_template(
            messages,
            tokenize=False,
            add_generation_prompt=True,
        )

        # Measure the original prompt, then truncate the formatted prompt
        # from the right if it exceeds the common input budget.
        original_ids = tokenizer(
            prompt, add_special_tokens=False
        )["input_ids"]
        was_truncated = len(original_ids) > MAX_INPUT_TOKENS

        inputs = tokenizer(
            prompt,
            return_tensors="pt",
            truncation=True,
            max_length=MAX_INPUT_TOKENS,
            add_special_tokens=False,
        ).to("cuda:0")

        try:
            with torch.inference_mode():
                output = model.generate(
                    **inputs,
                    max_new_tokens=MAX_NEW_TOKENS,
                    do_sample=False,
                    pad_token_id=tokenizer.eos_token_id,
                )

            answer = tokenizer.decode(
                output[0][inputs["input_ids"].shape[1]:],
                skip_special_tokens=True,
            ).strip()
            error = ""

        except Exception as e:
            answer = ""
            error = repr(e)

        oracle_results.append({
            "question_id": qid,
            "question_index": int(row["question_index"]),
            "context_type": context_type,
            "question": row["question"],
            "reference_answer": row["reference_answer"],
            "generated_answer": answer,
            "original_input_tokens": len(original_ids),
            "input_truncated": was_truncated,
            "generation_error": error,
        })

        completed.add((qid, context_type))

        # Save progress after each context.
        pd.DataFrame(oracle_results).to_csv(OUTPUT_PATH, index=False)

    if len(oracle_results) % 30 == 0:
        print(f"Saved {len(oracle_results)} generated answers")

oracle_results_df = pd.DataFrame(oracle_results)

print("\nORACLE GENERATION COMPLETE")
print("Total rows:", len(oracle_results_df))
print("Unique questions:", oracle_results_df["question_id"].nunique())
print("Generation errors:", (oracle_results_df["generation_error"] != "").sum())
print("\nBy context:")
display(
    oracle_results_df.groupby("context_type").agg(
        answers=("generated_answer", "count"),
        errors=("generation_error",
                lambda s: (s != "").sum()),
        truncated=("input_truncated", "sum"),
        mean_input_tokens=("original_input_tokens", "mean"),
    ).round(2)
)
print("\nSaved to:", OUTPUT_PATH)




