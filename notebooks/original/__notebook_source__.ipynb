import numpy as np
import pandas as pd

# Use your existing 600-question evaluation dataframe.
# If your dataframe has a different name, replace qa_df below.
eval_df = qa_df.copy()

# Keep answerable questions for Recall@K evaluation
eval_df = eval_df[
    eval_df["ANSWERABLE"].astype(str).str.upper() == "Y"
].reset_index(drop=True)

questions = (
    eval_df["QUESTION_TITLE"].fillna("") + " " +
    eval_df["QUESTION_TEXT"].fillna("")
).tolist()

ground_truth = eval_df["DOCUMENT"].tolist()

print("Answerable questions:", len(questions))

# Embed all questions in batches
query_embeddings = embed_model.encode(
    questions,
    batch_size=32,
    normalize_embeddings=True,
    show_progress_bar=True,
    convert_to_numpy=True
).astype(np.float32)

# Retrieve the top 20 chunks per question
scores, retrieved_indices = index.search(query_embeddings, 20)

# Evaluate whether the correct document appears in the top K chunks
results = []

for i, correct_doc in enumerate(ground_truth):
    retrieved_docs = [
        chunks_df.iloc[idx]["document_id"]
        for idx in retrieved_indices[i]
        if idx >= 0
    ]

    row = {"question_index": i, "correct_document": correct_doc}

    for k in [1, 3, 5, 10, 20]:
        row[f"Hit@{k}"] = int(correct_doc in retrieved_docs[:k])

    results.append(row)

results_df = pd.DataFrame(results)

print("\nRETRIEVAL EVALUATION")
print("-" * 35)

for k in [1, 3, 5, 10, 20]:
    recall = results_df[f"Hit@{k}"].mean()
    print(f"Recall@{k}: {recall:.4f} ({recall * 100:.2f}%)")



