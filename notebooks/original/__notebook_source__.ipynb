import re

def is_heading(line):
    line = line.strip()

    if not line:
        return False

    # Remove common formatting characters
    clean = re.sub(r"^[*\-_=+\s]+", "", line).strip()

    # Too long to be a heading
    if len(clean) > 100:
        return False

    # Ignore obvious list/code lines
    if line.startswith("*"):
        return False

    # Uppercase heading: ABSTRACT, CONTENT, SYMPTOM, etc.
    if clean.isupper() and any(c.isalpha() for c in clean):
        return True

    # Title-style headings: Problem Description, Problem Solution
    words = clean.split()

    if (
        1 <= len(words) <= 8
        and len(clean) <= 80
        and all(
            word[0].isupper()
            for word in words
            if word and word[0].isalpha()
        )
    ):
        return True

    return False


for i, line in enumerate(correct_doc["text"].splitlines()):
    if is_heading(line):
        print(i, repr(line))


def split_into_sections(text):
    sections = []

    current_heading = "DOCUMENT_START"
    current_lines = []

    for line in text.splitlines():
        if is_heading(line):
            if current_lines:
                sections.append({
                    "section": current_heading,
                    "text": "\n".join(current_lines).strip()
                })

            current_heading = line.strip()
            current_lines = []
        else:
            current_lines.append(line)

    if current_lines:
        sections.append({
            "section": current_heading,
            "text": "\n".join(current_lines).strip()
        })

    return sections


