# Fuse full-text BM25 and title-only BM25.
# Both ranking lists contain document IDs.

def rrf_fuse_document_rankings(
    rankings_a, rankings_b, rrf_k=60, weight_a=1.0, weight_b=1.0
):
    fused_rankings = []

    for rank_a, rank_b in zip(rankings_a, rankings_b):
        scores = {}

        for rank, docs, weight in [
            (1, rank_a, weight_a),
            (1, rank_b, weight_b),
        ]:
            ranking = rank_a if docs is rank_a else rank_b
            for position, doc_id in enumerate(ranking, start=1):
                scores[doc_id] = scores.get(doc_id, 0.0) + (
                    weight / (rrf_k + position)
                )

        fused_rankings.append(
            sorted(scores, key=scores.get, reverse=True)
        )

    return fused_rankings

