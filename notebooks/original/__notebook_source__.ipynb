# STEP 2A: Baseline answer evaluation
# No model loading, embeddings, or retrieval required.

import re
import numpy as np
import pandas as pd
from collections import Counter

def normalize_answer(text):
    text = str(text).lower()
    text = re.sub(r"[^a-z0-9]+", " ", text)
    return " ".join(text.split())

def token_f1(prediction, reference):
    pred = normalize_answer(prediction).split()
    gold = normalize_answer(reference).split()

    if not pred or not gold:
        return float(pred == gold)

    overlap = sum((Counter(pred) & Counter(gold)).values())
    if overlap == 0:
        return 0.0

    precision = overlap / len(pred)
    recall = overlap / len(gold)
    return 2 * precision * recall / (precision + recall)

# Extract common IBM technical identifiers.
ID_PATTERN = re.compile(
    r"\b(?:PI|PM|IV|JR|LO|PK)\d{4,6}\b",
    re.IGNORECASE
)

def required_ids(text):
    return set(x.upper() for x in ID_PATTERN.findall(str(text)))

rows = []

for _, r in results_df.iterrows():
    qid = str(r["question_id"])
    qa_matches = dev_eval_df[
        dev_eval_df["QUESTION_ID"].astype(str) == qid
    ]

    if len(qa_matches) != 1:
        continue

    qa = qa_matches.iloc[0]
    pred = str(r["generated_answer"])
    ref = str(qa["ANSWER"])

    gold_ids = required_ids(ref)
    pred_ids = required_ids(pred)

    # Evidence presence in the five selected chunks
    qi = int(r["question_index"])
    chunks = dev_hybrid_chunks[qi]
    context = " ".join(chunks["text"].fillna("").astype(str))

    rows.append({
        "question_id": qid,
        "token_f1": token_f1(pred, ref),
        "rougeL": (
            phase4_evaluated_df.loc[
                phase4_evaluated_df["question_id"] == qid,
                "rougeL"
            ].iloc[0]
            if (
                "rougeL" in phase4_evaluated_df.columns
                and (
                    phase4_evaluated_df["question_id"] == qid
                ).any()
            ) else np.nan
        ),
        "reference_exact_in_answer": ref.strip().lower()
            in pred.strip().lower(),
        "reference_exact_in_context": ref.strip().lower()
            in context.lower(),
        "required_ids": ", ".join(sorted(gold_ids)),
        "required_ids_present": (
            gold_ids.issubset(pred_ids) if gold_ids else np.nan
        ),
        "gold_document_in_context": (
            str(qa["DOCUMENT"]) in
            set(chunks["document_id"].astype(str))
        ),
    })

baseline_metrics_df = pd.DataFrame(rows)

print("EVALUATED QUESTIONS:", len(baseline_metrics_df))
print("\nBASELINE METRICS")
print("Mean token F1:",
      round(baseline_metrics_df["token_f1"].mean(), 4))
print("Median token F1:",
      round(baseline_metrics_df["token_f1"].median(), 4))
print("Exact reference in generated answers:",
      int(baseline_metrics_df["reference_exact_in_answer"].sum()))
print("Exact reference in selected contexts:",
      int(baseline_metrics_df["reference_exact_in_context"].sum()))
print("Gold document in selected contexts:",
      int(baseline_metrics_df["gold_document_in_context"].sum()))
print("Identifier match rate (identifier-bearing answers):",
      baseline_metrics_df["required_ids_present"].mean())

print("\nPER-QUESTION RESULTS")
display(baseline_metrics_df.head(15))

print("\nLOWEST TOKEN-F1 CASES")
display(
    baseline_metrics_df.sort_values("token_f1").head(10)
)




# STEP 2B: Prepare and validate oracle contexts
# A = full gold document
# B = answer-centered gold passage
# C = existing five hybrid chunks
#
# No model loading or generation in this cell.

import pandas as pd
import numpy as np

oracle_contexts = []
span_errors = []

for _, qa in dev_eval_df.iterrows():
    qid = str(qa["QUESTION_ID"])
    gold_id = str(qa["DOCUMENT"])

    if str(qa["ANSWERABLE"]).strip().upper() not in {"Y", "YES", "TRUE", "1"}:
        continue

    doc = technotes_data.get(gold_id)
    if not isinstance(doc, dict):
        span_errors.append((qid, "Gold document missing"))
        continue

    full_text = str(doc.get("text", "") or "")
    answer = str(qa["ANSWER"])
    start = int(qa["START_OFFSET"])
    end = int(qa["END_OFFSET"])

    # Validate the offsets against the reference answer.
    span = full_text[start:end] if 0 <= start <= end <= len(full_text) else ""

    if not full_text or not span:
        span_errors.append((qid, "Empty text/span or invalid offsets"))
        continue

    # Offsets are authoritative only if they match the reference.
    # Some records may have normalization or annotation differences.
    exact_span_match = span.strip() == answer.strip()

    # B: answer-centered passage, capped at 1,500 characters.
    # This is a controlled local-evidence oracle, not necessarily
    # the original semantic section boundary.
    window_size = 1500
    left = max(0, start - window_size // 2)
    right = min(len(full_text), max(end, left + window_size))
    left = max(0, right - window_size)

    answer_passage = full_text[left:right]

    # C: the saved baseline context aligned by question_index.
    result_match = results_df[
        results_df["question_id"].astype(str) == qid
    ]

    if len(result_match) != 1:
        span_errors.append((qid, "Result alignment failure"))
        continue

    question_index = int(result_match.iloc[0]["question_index"])
    if not (0 <= question_index < len(dev_hybrid_chunks)):
        span_errors.append((qid, "Context index out of range"))
        continue

    selected_df = dev_hybrid_chunks[question_index]
    selected_text = "\n\n".join(
        selected_df["title"].fillna("").astype(str)
        + " | "
        + selected_df["section"].fillna("").astype(str)
        + "\n"
        + selected_df["text"].fillna("").astype(str)
    )

    oracle_contexts.append({
        "question_id": qid,
        "question_index": question_index,
        "question": str(qa["QUESTION_TEXT"]),
        "gold_document": gold_id,
        "reference_answer": answer,
        "answer_start": start,
        "answer_end": end,
        "offset_span": span,
        "offset_matches_reference": exact_span_match,
        "context_A_full_document": full_text,
        "context_B_answer_passage": answer_passage,
        "context_C_hybrid": selected_text,
        "full_document_chars": len(full_text),
        "answer_passage_chars": len(answer_passage),
        "hybrid_context_chars": len(selected_text),
    })

oracle_df = pd.DataFrame(oracle_contexts)

print("ORACLE CONTEXT PREPARATION")
print("Prepared questions:", len(oracle_df))
print("Offset span matches reference:",
      int(oracle_df["offset_matches_reference"].sum()))
print("Offset mismatches:",
      int((~oracle_df["offset_matches_reference"]).sum()))
print("Offset issues:", len(span_errors))

print("\nCONTEXT LENGTHS")
display(
    oracle_df[
        [
            "full_document_chars",
            "answer_passage_chars",
            "hybrid_context_chars"
        ]
    ].describe().round(1)
)

print("\nOFFSET MISMATCH EXAMPLES")
display(
    oracle_df.loc[
        ~oracle_df["offset_matches_reference"],
        ["question_id", "reference_answer", "offset_span"]
    ].head(10)
)

print("\nSAMPLE ORACLE RECORD")
if len(oracle_df):
    sample = oracle_df.iloc[0]
    print("Question:", sample["question_id"])
    print("Gold document:", sample["gold_document"])
    print("Reference:", sample["reference_answer"])
    print("\nAnswer passage:\n", sample["context_B_answer_passage"][:1200])

if span_errors:
    print("\nALIGNMENT / DOCUMENT ISSUES (first 10)")
    print(span_errors[:10])




print("Oracle DataFrame columns:")
print(oracle_df.columns.tolist())

print("\nShape:", oracle_df.shape)
print("\nFirst record:")
display(oracle_df.head(1))


