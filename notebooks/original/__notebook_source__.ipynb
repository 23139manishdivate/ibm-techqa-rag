def bm25_document_rankings(index, query_list, top_chunks=5000):
    rankings = []

    for query in query_list:
        scores = np.asarray(
            index.get_scores(tokenize_fixed(query)),
            dtype=np.float32
        )

        n = min(top_chunks, len(scores))
        candidate_idx = np.argpartition(scores, -n)[-n:]
        candidate_idx = candidate_idx[
            np.argsort(scores[candidate_idx])[::-1]
        ]

        # Keep the maximum chunk score for each document.
        best_scores = {}
        for idx in candidate_idx:
            doc_id = doc_ids[idx]
            score = float(scores[idx])
            if doc_id and (
                doc_id not in best_scores or score > best_scores[doc_id]
            ):
                best_scores[doc_id] = score

        ranked_docs = sorted(
            best_scores,
            key=best_scores.get,
            reverse=True
        )
        rankings.append(ranked_docs)

    return rankings

# Original index uses its original tokenization for queries.
def old_bm25_document_rankings(index, query_list, top_chunks=5000):
    rankings = []

    for query in query_list:
        scores = np.asarray(
            index.get_scores(tokenize(query)),
            dtype=np.float32
        )

        n = min(top_chunks, len(scores))
        candidate_idx = np.argpartition(scores, -n)[-n:]
        candidate_idx = candidate_idx[
            np.argsort(scores[candidate_idx])[::-1]
        ]

        best_scores = {}
        for idx in candidate_idx:
            doc_id = doc_ids[idx]
            score = float(scores[idx])
            if doc_id and (
                doc_id not in best_scores or score > best_scores[doc_id]
            ):
                best_scores[doc_id] = score

        rankings.append(
            sorted(best_scores, key=best_scores.get, reverse=True)
        )

    return rankings

