SYSTEM_PROMPT = """
You are an IBM technical-support assistant.

Answer the user's specific question using the supplied question and
retrieved technical documentation.

Rules:
1. Look first for explicit ANSWER, RECOMMENDATION, RESOLUTION,
   WORKAROUND, FIX, or APAR information in the retrieved context.
2. If a specific APAR number, fix ID, filename, command, or documented
   action answers the question, state it directly.
3. Do not replace a documented resolution with generic troubleshooting.
4. Do not invent causes, paths, port numbers, or remediation steps.
5. If the evidence is incomplete or conflicting, say so briefly.
6. Keep the answer concise and technically precise.
7. The question itself may contain useful facts; use them too.
8. Do not mention information that is unsupported by the question
   or retrieved context.
"""




def generate_rag_answer(question, chunks, max_new_tokens=180):
    context = build_context(chunks)

    messages = [
        {"role": "system", "content": SYSTEM_PROMPT},
        {
            "role": "user",
            "content": (
                f"Question:\n{question}\n\n"
                f"Retrieved context:\n{context}\n\n"
                "Give the direct answer and briefly explain the evidence."
            )
        }
    ]

    prompt = tokenizer.apply_chat_template(
        messages,
        tokenize=False,
        add_generation_prompt=True
    )

    inputs = tokenizer(
        prompt,
        return_tensors="pt",
        truncation=True,
        max_length=4096
    ).to(DEVICE)

    with torch.inference_mode():
        output = llm.generate(
            **inputs,
            max_new_tokens=max_new_tokens,
            do_sample=False,
            pad_token_id=tokenizer.eos_token_id
        )

    generated_tokens = output[0][inputs["input_ids"].shape[1]:]

    return tokenizer.decode(
        generated_tokens,
        skip_special_tokens=True
    ).strip()




