import numpy as np
from tqdm.auto import tqdm

TOP_DOCS = 20
TOP_CHUNKS = 5
CHUNK_BATCH_SIZE = 32

dev_selected_chunks = []
dev_chunk_candidates = []

for q_idx, question in enumerate(tqdm(dev_questions, desc="Selecting context")):
    ranked_docs = set(
        str(doc_id) for doc_id in dev_fused_rankings[q_idx][:TOP_DOCS]
    )

    candidates = chunks_df[
        chunks_df["document_id"].astype(str).isin(ranked_docs)
    ].copy()

    candidates = candidates.drop_duplicates(
        subset=["document_id", "chunk_index", "text"]
    ).reset_index(drop=True)

    if candidates.empty:
        dev_chunk_candidates.append(candidates)
        dev_selected_chunks.append(candidates)
        continue

    # Embed candidate chunks only, not the entire corpus
    chunk_texts = candidates["text"].fillna("").astype(str).tolist()

    chunk_embeddings = embed_model.encode(
        chunk_texts,
        batch_size=CHUNK_BATCH_SIZE,
        show_progress_bar=False,
        convert_to_numpy=True,
        normalize_embeddings=True
    )

    q_embedding = dev_query_embeddings[q_idx]
    similarities = np.asarray(chunk_embeddings) @ q_embedding

    candidates["similarity"] = similarities
    candidates = candidates.sort_values(
        "similarity", ascending=False
    ).reset_index(drop=True)

    dev_chunk_candidates.append(candidates)
    dev_selected_chunks.append(candidates.head(TOP_CHUNKS).copy())

print("Questions processed:", len(dev_selected_chunks))
print("Selected chunks for first question:", len(dev_selected_chunks[0]))

