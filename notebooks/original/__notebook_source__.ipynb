import pandas as pd
import numpy as np
from rouge_score import rouge_scorer
from bert_score import score

answers_path = "/kaggle/working/techqa_phase4_answers.csv"
results_df = pd.read_csv(answers_path)

predictions = results_df["generated_answer"].fillna("").astype(str).tolist()
references = results_df["reference_answer"].fillna("").astype(str).tolist()

# ROUGE-L
scorer = rouge_scorer.RougeScorer(["rougeL"], use_stemmer=True)
rouge_scores = [
    scorer.score(ref, pred)["rougeL"].fmeasure
    for pred, ref in zip(predictions, references)
]

