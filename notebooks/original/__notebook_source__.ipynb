MIN_SECTION_TOKENS = 50

def merge_small_sections(sections, tokenizer, min_tokens=50):
    merged = []
    buffer = None

    for section in sections:
        text = section["text"].strip()

        if not text:
            continue

        token_count = len(
            tokenizer.encode(text, add_special_tokens=False)
        )

        if buffer is None:
            buffer = {
                "section": section["section"],
                "text": text
            }
            continue

        if token_count < min_tokens:
            # Merge small section with previous section
            buffer["text"] += "\n\n" + text
        else:
            merged.append(buffer)
            buffer = {
                "section": section["section"],
                "text": text
            }

    if buffer:
        merged.append(buffer)

    return merged


