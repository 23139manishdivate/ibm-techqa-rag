import re
from collections import Counter

# Common section-heading pattern:
# headings are usually uppercase words/phrases on their own line
section_counter = Counter()

for text in docs_df["text"]:
    lines = text.splitlines()

    for line in lines:
        line = line.strip()

        # Keep reasonably sized uppercase headings
        if (
            3 <= len(line) <= 80
