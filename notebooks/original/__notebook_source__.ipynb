import re
import pandas as pd

def normalize_answer(text):
    if not isinstance(text, str):
        return ""
    # Normalize case, whitespace, and common formatting differences.
    text = text.lower()
    text = re.sub(r"\s+", " ", text)
    text = re.sub(r"[`*_]", "", text)
    return text.strip()

# eval_df and hybrid_rankings must have identical question ordering.
assert len(eval_df) == len(hybrid_rankings) == 450

# Precompute normalized chunk text and document IDs.
chunk_texts = chunks_df["text"].fillna("").astype(str).tolist()
chunk_texts_norm = [normalize_answer(t) for t in chunk_texts]
chunk_doc_ids = (
    chunks_df["document_id"].fillna("").astype(str).str.strip().tolist()
)

# Find whether the answer occurs anywhere in the processed gold document.
gold_document_answer_available = []

for _, row in eval_df.iterrows():
    gold_id = str(row["DOCUMENT"]).strip()
    answer = normalize_answer(row["ANSWER"])

    matching_texts = [
        chunk_texts_norm[i]
        for i, doc_id in enumerate(chunk_doc_ids)
        if doc_id == gold_id
    ]

    available = bool(answer) and any(
        answer in text for text in matching_texts
    )
    gold_document_answer_available.append(available)

print(
    "Answers found in at least one gold-document chunk:",
    sum(gold_document_answer_available), "/", len(eval_df)
)

# Evaluate existing hybrid chunk rankings.
results = []

for q_idx, (_, row) in enumerate(eval_df.iterrows()):
    gold_id = str(row["DOCUMENT"]).strip()
    answer = normalize_answer(row["ANSWER"])
    ranking = hybrid_rankings[q_idx]

    # Verify the ranking entries are valid positional chunk indices.
    valid_indices = [
        int(i) for i in ranking
        if isinstance(i, (int,)) and 0 <= int(i) < len(chunks_df)
    ]

    for k in [5, 10, 20, 50]:
        top_indices = valid_indices[:k]

        gold_hit = any(
            chunk_doc_ids[i] == gold_id for i in top_indices
        )

        answer_hit = bool(answer) and any(
            answer in chunk_texts_norm[i] for i in top_indices
        )

        results.append({
            "question_idx": q_idx,
            "question_id": row["QUESTION_ID"],
            "K": k,
            "gold_document_hit": gold_hit,
            "answer_contained": answer_hit,
            "answer_available_in_gold": gold_document_answer_available[q_idx],
        })

chunk_eval = pd.DataFrame(results)

summary = (
    chunk_eval.groupby("K")
    .agg(
        gold_document_hits=("gold_document_hit", "sum"),
        answer_containment_hits=("answer_contained", "sum"),
        total=("question_id", "count"),
    )
    .reset_index()
)

summary["gold_document_recall"] = (
    summary["gold_document_hits"] / summary["total"]
)
summary["answer_containment_recall"] = (
    summary["answer_containment_hits"] / summary["total"]
)

display(summary)

# Inspect examples where the gold document is retrieved but the
# reference answer is not contained in the retrieved chunks.
at20 = chunk_eval[chunk_eval["K"] == 20]

misses = at20[
    at20["gold_document_hit"] & ~at20["answer_contained"]
]

print("\nGold document retrieved, but answer not contained in top 20:",
      len(misses))
display(misses[["question_id"]].head(15))




