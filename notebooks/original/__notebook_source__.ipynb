import os
import numpy as np
import time

EMBED_BATCH_SIZE = 32
CHECKPOINT_SIZE = 5000
EMBED_DIR = "/kaggle/working/embedding_batches"

texts = chunks_df["text"].tolist()
total_chunks = len(texts)

start_time = time.time()

for checkpoint_start in range(0, total_chunks, CHECKPOINT_SIZE):

    checkpoint_end = min(
        checkpoint_start + CHECKPOINT_SIZE,
        total_chunks
    )

    checkpoint_path = os.path.join(
        EMBED_DIR,
        f"embeddings_{checkpoint_start:06d}_{checkpoint_end:06d}.npy"
    )

    # Skip checkpoint if it already exists
    if os.path.exists(checkpoint_path):
        print(f"Skipping existing checkpoint: {checkpoint_start}-{checkpoint_end}")
        continue

    print(
        f"\nProcessing chunks {checkpoint_start} → {checkpoint_end}"
    )

    checkpoint_embeddings = []

    for batch_start in range(
        checkpoint_start,
        checkpoint_end,
        EMBED_BATCH_SIZE
    ):

        batch_end = min(
            batch_start + EMBED_BATCH_SIZE,
            checkpoint_end
        )

        batch_texts = texts[batch_start:batch_end]

        batch_embeddings = embed_model.encode(
            batch_texts,
            batch_size=EMBED_BATCH_SIZE,
            normalize_embeddings=True,
            show_progress_bar=False
        )

        checkpoint_embeddings.append(batch_embeddings)

        print(
            f"\rProcessed {batch_end}/{checkpoint_end}",
            end=""
        )

    # Combine batches
    checkpoint_embeddings = np.vstack(checkpoint_embeddings)

    # Save to disk
    np.save(checkpoint_path, checkpoint_embeddings)

    print(
        f"\nSaved: {checkpoint_path}"
        f" | Shape: {checkpoint_embeddings.shape}"
    )

elapsed = time.time() - start_time

print("\nEmbedding process finished.")
print("Total time:", round(elapsed / 60, 2), "minutes")


