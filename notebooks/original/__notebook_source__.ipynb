        if chunk_idx < 0:
            continue

        doc_id = str(chunks_df.iloc[chunk_idx]["document_id"])
        doc_scores[doc_id] = max(
            doc_scores.get(doc_id, float("-inf")),
            float(score)
        )

    ranked_docs = sorted(
        doc_scores,
        key=doc_scores.get,
        reverse=True
    )
    semantic_rankings.append(ranked_docs)

print("Questions:", len(semantic_rankings))
print("Documents ranked for first question:", len(semantic_rankings[0]))
print("Top 5:", semantic_rankings[0][:5])




def rrf_fuse_three(rankings_a, rankings_b, rankings_c, rrf_k=60):
    fused = []

    for a, b, c in zip(rankings_a, rankings_b, rankings_c):
        scores = defaultdict(float)

        for ranking in (a, b, c):
            for position, doc_id in enumerate(ranking, start=1):
                scores[str(doc_id)] += 1.0 / (rrf_k + position)

        fused.append(
            sorted(scores, key=scores.get, reverse=True)
        )

    return fused


semantic_bm25_title_rankings = rrf_fuse_three(
    semantic_rankings,
    fixed_bm25_rankings,
    title_only_rankings
)

print("Fused questions:", len(semantic_bm25_title_rankings))
