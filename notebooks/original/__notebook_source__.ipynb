from collections import defaultdict
import re

WEIGHT = 0.02
RRF_K = 60

def get_title_tokens(text):
    return set(
        re.findall(r"[a-zA-Z0-9][a-zA-Z0-9._/-]*", str(text).lower())
    ) - STOPWORDS

document_rankings = []

for i, question in enumerate(questions):
    q_tokens = get_title_tokens(question)

    # Aggregate scores across chunks belonging to the same document
    doc_scores = defaultdict(float)

    for rank, idx in enumerate(hybrid_rankings[i], start=1):
        row = chunks_df.iloc[idx]
        doc_id = str(row["document_id"])
        title = row["title"] if "title" in chunks_df.columns else ""

        title_tokens_set = get_title_tokens(title)
        overlap = len(q_tokens & title_tokens_set) / max(len(q_tokens), 1)

        # Original RRF contribution + title-aware contribution
        score = (1.0 / (RRF_K + rank)) + WEIGHT * overlap

        # Sum chunk contributions at document level
        doc_scores[doc_id] += score

    ranked_docs = sorted(
        doc_scores.items(),
        key=lambda item: item[1],
        reverse=True
    )

    document_rankings.append([doc_id for doc_id, score in ranked_docs])

print("Document-level rankings:", len(document_rankings))
print("Unique documents for first question:", len(document_rankings[0]))


def document_recall_at_k(rankings, k):
    hits = sum(
        str(ground_truth[i]) in rankings[i][:k]
        for i in range(len(ground_truth))
    )
    return hits / len(ground_truth)

print("Comparison: existing vs document-level aggregation\n")

for k in [5, 10, 20, 50, 100]:
    old_score = recall_at_k(title_aware_rankings, k)
    new_score = document_recall_at_k(document_rankings, k)

    print(
        f"Recall@{k}: "
        f"Existing={old_score:.2%} | "
        f"Document-level={new_score:.2%} | "
        f"Change={(new_score - old_score) * 100:+.2f} pp"
    )


