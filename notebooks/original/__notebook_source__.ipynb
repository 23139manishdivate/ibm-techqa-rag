import faiss
import numpy as np
import os
import time

INDEX_PATH = "/kaggle/working/techqa_faiss.index"

# BGE-M3 embedding dimension
DIM = 1024

# Exact inner-product search
index = faiss.IndexFlatIP(DIM)

files = sorted(
    f for f in os.listdir(EMBED_DIR)
    if f.endswith(".npy")
)

print("Checkpoint files:", len(files))
print("Expected vectors:", len(chunks_df))
print("Building FAISS index...\n")

start_time = time.time()
total_added = 0

for i, file in enumerate(files, 1):

    path = os.path.join(EMBED_DIR, file)

    # Memory-map the file so we don't unnecessarily duplicate it in RAM
    embeddings = np.load(path, mmap_mode="r")

    index.add(embeddings)

    total_added += embeddings.shape[0]

    print(
        f"[{i}/{len(files)}] "
        f"{file} → added {embeddings.shape[0]} | "
        f"total: {total_added}"
    )

elapsed = time.time() - start_time

print("\nFAISS indexing complete.")
print("Total vectors:", index.ntotal)
print("Vector dimension:", index.d)
print("Time:", round(elapsed / 60, 2), "minutes")

# Save index
faiss.write_index(index, INDEX_PATH)

print("\nSaved index:")
print(INDEX_PATH)

print(
    "Index size:",
    round(os.path.getsize(INDEX_PATH) / (1024**2), 2),
    "MB"
)


