SECTION_HEADINGS = [
    "PROBLEM SUMMARY",
    "ERROR DESCRIPTION",
    "PROBLEM CONCLUSION",
    "LOCAL FIX",
    "TEMPORARY FIX",
    "RESOLVING THE PROBLEM",
    "PROBLEM(ABSTRACT)",
    "SYMPTOM",
