import re
from rank_bm25 import BM25Okapi

def tokenize(text):
    # Preserve technical identifiers such as CVE-2017-3156
    return re.findall(r"[a-zA-Z0-9][a-zA-Z0-9._/-]*", str(text).lower())

# Keep exactly the same chunk order as the FAISS index
chunk_texts = chunks_df["text"].fillna("").tolist()

tokenized_chunks = [
    tokenize(text) for text in chunk_texts
]

bm25_index = BM25Okapi(tokenized_chunks)

print("BM25 index built successfully")
print("Indexed chunks:", len(tokenized_chunks))
print("Example tokens:", tokenize(
    "Is ITNM affected by CVE-2017-3156?"
))




# Reuse the known ITNM vulnerability question
test_question = (
    "Is ITNM exposed to Apache CXF vulnerability "
    "(CVE-2017-3156)? Which versions are affected?"
)

query_tokens = tokenize(test_question)
bm25_scores = bm25_index.get_scores(query_tokens)

top_bm25 = bm25_scores.argsort()[-5:][::-1]

for rank, idx in enumerate(top_bm25, start=1):
    chunk = chunks_df.iloc[idx]
    print(f"\nRank: {rank} | BM25 score: {bm25_scores[idx]:.3f}")
    print("Document:", chunk["document_id"])
    print("Title:", chunk["title"])
    print("Text:", chunk["text"][:300])




import numpy as np
from collections import defaultdict

# Retrieve top 100 semantic candidates per question
semantic_scores, semantic_indices = index.search(query_embeddings, 100)

RRF_K = 60
TOP_CANDIDATES = 100
hybrid_rankings = []

for i, question in enumerate(questions):
    # Semantic ranking: FAISS results are already sorted
    semantic_list = [
        int(idx) for idx in semantic_indices[i] if idx >= 0
    ]

    # Keyword ranking: BM25 top 100
    bm25_scores = bm25_index.get_scores(tokenize(question))
    keyword_indices = np.argpartition(
        bm25_scores, -TOP_CANDIDATES
    )[-TOP_CANDIDATES:]

    keyword_list = keyword_indices[
        np.argsort(bm25_scores[keyword_indices])[::-1]
    ].tolist()

    # Reciprocal Rank Fusion
    rrf_scores = defaultdict(float)

    for rank, idx in enumerate(semantic_list, start=1):
        rrf_scores[idx] += 1.0 / (RRF_K + rank)

    for rank, idx in enumerate(keyword_list, start=1):
        rrf_scores[idx] += 1.0 / (RRF_K + rank)

    # Sort the union of candidates by fused score
    fused = sorted(
        rrf_scores.items(),
        key=lambda item: item[1],
        reverse=True
    )

    hybrid_rankings.append([idx for idx, _ in fused])

    if (i + 1) % 50 == 0:
        print(f"Processed {i + 1}/{len(questions)} questions")

print("Hybrid retrieval complete:", len(hybrid_rankings))




ks = [1, 3, 5, 10, 20, 50, 100]

print("HYBRID RETRIEVAL EVALUATION")
print("-" * 35)

for k in ks:
    hits = 0

    for i, correct_doc in enumerate(ground_truth):
        retrieved_docs = [
            chunks_df.iloc[idx]["document_id"]
            for idx in hybrid_rankings[i][:k]
        ]

        if correct_doc in retrieved_docs:
            hits += 1

    recall = hits / len(ground_truth)
    print(f"Recall@{k}: {recall:.4f} ({recall * 100:.2f}%)")




# Evaluate larger hybrid candidate pools
for k in [100, 120, 150, 200]:
    hits = 0

    for i, correct_doc in enumerate(ground_truth):
        candidate_indices = hybrid_rankings[i][:k]

        retrieved_docs = {
            chunks_df.iloc[idx]["document_id"]
            for idx in candidate_indices
        }

        if correct_doc in retrieved_docs:
            hits += 1

    recall = hits / len(ground_truth)
    print(f"Hybrid Recall@{k}: {recall:.4f} ({recall * 100:.2f}%)")




